diff --git "a/\345\244\207\344\273\275\\20261101-\345\210\240\351\231\244\345\275\223\345\211\215\345\270\247\345\212\237\350\203\275\\API_DOCS.md.before" b/API_DOCS.md
index adf0bfd..4d8d284 100644
--- "a/\345\244\207\344\273\275\\20261101-\345\210\240\351\231\244\345\275\223\345\211\215\345\270\247\345\212\237\350\203\275\\API_DOCS.md.before"
+++ b/API_DOCS.md
@@ -295,6 +295,7 @@ interface APIResult<T = any> {
 - `copyLayerToFrames(source, targets, options={})`：一次指定源与目标列表，适合 AI 连续调用；不改变剪贴板或页面选择。目标项省略 `sheetIndex`、`layerIndex` 时沿用源，其余省略索引取当前项。跨素材表复制时需指定属于目标素材表的可编辑 `layerIndex`。
 - `copyLayerToNextFrame(source={})`：复制当前图层并跳转下一帧。末帧时复制当前整帧追加，保留其他图层和保护设置；返回 `createdFrame`。源必须是页面当前帧。
 - `duplicateFrame()`：将当前帧所有图层复制到当前动作末尾并跳转，可撤销。
+- `deleteFrame()`：删除当前朝向的当前整帧，所有图层（含隐藏层、手层）一起重排，其他朝向和素材表不变。返回 `deletedFrameIndex`、当前 `frameIndex` 和剩余 `frameCount`。支持撤销/重做，需手动保存工程；每个朝向至少保留一帧，绘画中、帧有锁定/保护区域时拒绝。共享人物底稿分支按主工程帧编号同步，暂不允许独立删帧，以免保存后错位。界面的“删除当前帧”按钮有确认提示；API 调用直接执行。
 
 `options` 为 `{mode:'overlay'|'replace', x?, y?}`。默认 `overlay` 只写源非透明像素，目标其他像素保留；`replace` 包含透明像素，覆盖粘贴矩形范围；`x/y` 默认保留源位置。批量目标最多 256 项，会先校验所有目标，任一锁定、保护、错误图层或越界则整批不写；成功的批量修改仅占一次撤销。结果包含 `targetCount`（实际发生变化的帧数）、`modifiedPixels` 和已修改目标列表。原样复制不自动生成新朝向。
 
